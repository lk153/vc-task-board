# Copy to .env.local for local development.
# On Vercel these are set in Project Settings → Environment Variables
# (DATABASE_URL* are added automatically by the Neon integration).

# Database — local Postgres from `pnpm db:up`
DATABASE_URL=postgres://postgres:postgres@localhost:5434/taskboard
# DATABASE_URL_UNPOOLED=  # Neon: direct connection, used for migrations when set

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally: the Google button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth proxy so Google sign-in works on Preview deployments.
# Must be the same value in Production and Preview.
OAUTH_PROXY_SECRET=
